NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Stripe · Pago del llavero NFC (sin autenticación) ──
# Pega aquí tu Stripe Payment Link (https://buy.stripe.com/...). Puedes usar uno
# genérico o uno por producto. Si ninguno está definido, el checkout ofrece
# cerrar la compra por WhatsApp como respaldo.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
NEXT_PUBLIC_STRIPE_LINK_STD=
NEXT_PUBLIC_STRIPE_LINK_PREM=
NEXT_PUBLIC_STRIPE_LINK_CUSTOM=

# ── Wompi · Pago real del llavero NFC (reemplaza el camino Stripe de arriba) ──
# Llave pública del dashboard de Wompi (Desarrolladores > Llaves de API).
# Es pública a propósito, va al navegador — pub_test_... en sandbox,
# pub_prod_... en producción. Las llaves secretas van en backend/.env, nunca acá.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
