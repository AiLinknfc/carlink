{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile"
  },
  "deploy": {
    "startCommand": "python -m app.services.r2_cleanup --apply --include-existing-users",
    "cronSchedule": "0 8 * * 0",
    "restartPolicyType": "NEVER"
  }
}
